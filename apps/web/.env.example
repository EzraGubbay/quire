# Postgres (docker compose dev default)
DATABASE_URL=postgres://quire:quire@localhost:5432/quire
# Where uploaded PDFs and artifacts are stored
FILES_DIR=./data/files
# Login. 'none' for local dev; 'github' in production (GitHub OAuth app, one allowed login).
AUTH_MODE=none
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGIN=EzraGubbay
# Bearer key accepted on /api/* for the Python client
QUIRE_API_KEY=
# OpenAI (Phase 4)
OPENAI_API_KEY=

{
  "request": {
    "method": "tools/call",
    "name": "get_file",
    "arguments": {
      "course": "<slug:course>",
      "fileId": "<id:lecture-deck>",
      "pages": "x"
    }
  },
  "response": {
    "isError": true,
    "content": [
      {
        "type": "text",
        "text": "Bad page range \"x\". Use e.g. \"3\", \"2-5\", \"1-3,7\" or \"10-\"."
      }
    ]
  }
}

{
  "request": {
    "method": "tools/call",
    "name": "get_page_images",
    "arguments": {
      "course": "<slug:course>",
      "fileId": "<id:lecture-deck>",
      "pages": "1"
    }
  },
  "response": {
    "content": [
      {
        "type": "text",
        "text": "Images of \"Lecture 1 slides\" page(s) 1 follow. If your client shows no images, get_file with pages=\"1\" returns the same pages as text."
      },
      {
        "type": "text",
        "text": "Page 1 of \"Lecture 1 slides\":"
      },
      {
        "type": "image",
        "mimeType": "image/jpeg",
        "jpeg": true,
        "nonEmpty": true,
        "withinCap": true
      }
    ]
  }
}

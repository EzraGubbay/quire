{
  "request": {
    "method": "tools/call",
    "name": "get_page_images",
    "arguments": {
      "project": "<slug:research>",
      "fileId": "<id:paper>",
      "pages": "1"
    }
  },
  "response": {
    "content": [
      {
        "type": "text",
        "text": "Page 1 of \"A Synthetic Paper\":"
      },
      {
        "type": "image",
        "mimeType": "image/jpeg",
        "jpeg": true,
        "nonEmpty": true,
        "withinCap": true
      }
    ]
  }
}

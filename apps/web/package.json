    "@quire/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }

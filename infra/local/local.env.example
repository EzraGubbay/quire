# Copied to $QUIRE_LOCAL_DIR/local.env by `pnpm local:up` the first time. Edit, then `pnpm local:up` again.
# Real AI (synthesis, tutor chat, tests): set the key and leave AI_MOCK empty. Without a key, set AI_MOCK=1 to get
# canned answers so the rest of the app still works.
OPENAI_API_KEY=
AI_MOCK=1
# To exercise a Claude route locally (leave AI_MOCK empty), set the provider in Settings → AI and provide the
# matching credential. Embeddings still need OPENAI_API_KEY.
# ANTHROPIC_API_KEY=          # for the Claude API route
# CLAUDE_CODE_OAUTH_TOKEN=    # for the Claude Subscription route (claude setup-token)

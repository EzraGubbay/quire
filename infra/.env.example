# Copy to /srv/quire/.env on the Pi. Never commit the real file.
POSTGRES_PASSWORD=change-me
QUIRE_IMAGE=ghcr.io/ezragubbay/quire:latest
# Cloudflare Tunnel token: on a machine with the account's origin cert,
#   cloudflared tunnel --origincert ~/.cloudflared/cert.pem token quire-pi
CF_TUNNEL_TOKEN=
# Set to 'tunnel' to start cloudflared (requires CF_TUNNEL_TOKEN)
COMPOSE_PROFILES=tunnel
# Login: GitHub OAuth app restricted to one GitHub login. AUTH_MODE=none disables auth (dev only).
AUTH_MODE=github
AUTH_URL=https://quire.ezragubbay.com
AUTH_SECRET=            # openssl rand -base64 33
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGIN=EzraGubbay
# Bearer key for the Python client and CI health checks: qk_ + openssl rand -hex 24
QUIRE_API_KEY=
# OpenAI (Phase 4)
OPENAI_API_KEY=
# Backblaze B2
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=quire-backups
BACKUP_CRON=15 3 * * *

# Copy to /srv/quire/.env on the Pi. Never commit the real file.
POSTGRES_PASSWORD=change-me
QUIRE_IMAGE=ghcr.io/ezragubbay/quire:latest
# Cloudflare Zero Trust: tunnel token (Networks > Tunnels > your tunnel > token)
CF_TUNNEL_TOKEN=
# Set to 'tunnel' to start cloudflared (requires CF_TUNNEL_TOKEN)
COMPOSE_PROFILES=
# Access application: team domain like https://<team>.cloudflareaccess.com and the application AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# OpenAI (Phase 4)
OPENAI_API_KEY=
# Backblaze B2
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=quire-backups
BACKUP_CRON=15 3 * * *

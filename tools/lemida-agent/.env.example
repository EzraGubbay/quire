# Copy to .env and fill in. Loaded by the npm scripts via `node --env-file-if-exists=.env`.

# Where Quire lives. The deployed Pi, or http://localhost:3000 when running Quire locally.
QUIRE_BASE_URL=https://quire.ezragubbay.com

# Quire API key (the same QUIRE_API_KEY the Pi uses). Required against the Pi; leave blank
# when Quire runs locally with AUTH_MODE=none. Never commit the real value.
QUIRE_API_KEY=

# Lemida entry points (defaults shown; override only if they change).
# LOGIN goes straight to the student 365 sign-in; HOME is used to check the session.
LEMIDA_LOGIN_URL=https://lemida.biu.ac.il/auth/multioauth/login.php?userType=student
LEMIDA_HOME_URL=https://lemida.biu.ac.il/my/

# Which browser Playwright drives. Empty = auto-detect your OS default (Brave/Chrome/Edge/…).
# Or set a name (brave, chrome, edge, vivaldi, arc, chromium) or an absolute path to the browser binary.
# Must be a Chromium-family browser; a non-Chromium default (Safari/Firefox) falls back to bundled Chromium.
# LEMIDA_BROWSER=

# Optional tuning.
# LEMIDA_POLL_MS=5000          # how often to check for a queued command
# LEMIDA_PROBE_MS=3600000      # passive session check interval (1h)
# LEMIDA_LOGIN_TIMEOUT_MS=300000
# LEMIDA_PROFILE_DIR=./.profile
